<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="clr-namespace:Axphi.Components">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Axphi;component/Themes/CommonResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type comp:TimelineRenderSurface}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinViewportX" Value="-5" />
        <Setter Property="MinZoom" Value="0.1" />
        <Setter Property="MaxZoom" Value="40" />
        <Setter Property="ZoomStep" Value="0.1" />
        <Setter Property="HorizontalScrollSpeed" Value="0.1" />
        <Setter Property="VerticalScrollSpeed" Value="0.1" />
    </Style>

    <Style TargetType="{x:Type comp:Playhead}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Margin" Value="-16,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comp:Playhead}">
                    <Grid>
                        <Rectangle Width="1.5"
                                   Fill="#FF3333"
                                   HorizontalAlignment="Center"
                                   IsHitTestVisible="False" />

                        <Path Data="M 0 0 L 16 0 L 8 10 Z"
                              Fill="#FF3333"
                              Height="14"
                              VerticalAlignment="Top"
                              Margin="8,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
